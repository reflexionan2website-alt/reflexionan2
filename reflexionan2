        // Configurar Protecciones Anti-Descarga / Anti-Copia
        function setupAntiPlagiarismControls() {
            // Desactivar atajos de teclado clave (Ctrl+C, Ctrl+U, Ctrl+S, F12)
            document.addEventListener('keydown', (e) => {
                if (
                    e.keyCode === 123 || // F12
                    (e.ctrlKey && e.shiftKey && e.keyCode === 73) || // Ctrl+Shift+I
                    (e.ctrlKey && e.keyCode === 85) || // Ctrl+U
                    (e.ctrlKey && e.keyCode === 83) || // Ctrl+S
                    (e.ctrlKey && e.keyCode === 67 && window.getSelection().toString().length > 0) // Ctrl+C
                ) {
                    e.preventDefault();
                    showToast('Acción no permitida por protección de derechos de autor', 'fa-shield-halved');
                    return false;
                }
            });
        }

        /* ==========================================================================
           GESTIÓN DE PESTAÑAS Y RENDERIZADO
           ========================================================================== */

        function switchTab(tabId) {
            currentTab = tabId;

            // Ocultar todas las secciones
            document.querySelectorAll('.gallery-section').forEach(sec => sec.classList.add('hidden'));
            document.getElementById(`sec-${tabId}`).classList.remove('hidden');

            // Actualizar estilo botones Navegación Desktop
            const tabs = ['audiolibros', 'libros', 'canciones'];
            tabs.forEach(t => {
                const btn = document.getElementById(`nav-${t}`);
                const mobBtn = document.getElementById(`mob-${t}`);
                if (t === tabId) {
                    btn.className = "px-5 py-2 rounded-full text-sm font-medium transition-all duration-300 flex items-center space-x-2 bg-purple-600/60 text-white shadow-lg shadow-purple-900/50";
                    if(mobBtn) mobBtn.className = "flex flex-col items-center py-1 px-3 text-xs text-pink-400 font-bold";
                } else {
                    btn.className = "px-5 py-2 rounded-full text-sm font-medium transition-all duration-300 flex items-center space-x-2 text-purple-200 hover:text-white hover:bg-purple-900/30";
                    if(mobBtn) mobBtn.className = "flex flex-col items-center py-1 px-3 text-xs text-slate-400";
                }
            });
        }

        function renderGalleries() {
            const categories = ['audiolibros', 'libros', 'canciones'];

            categories.forEach(cat => {
                const grid = document.getElementById(`grid-${cat}`);
                const countBadge = document.getElementById(`count-${cat}`);
                const filtered = items.filter(i => i.category === cat && !i.hidden);

                countBadge.innerText = `${filtered.length} obras`;
                grid.innerHTML = '';

                if (filtered.length === 0) {
                    grid.innerHTML = `
                        <div class="col-span-full text-center py-12 glass-card rounded-2xl border-purple-500/20">
                            <i class="fa-solid fa-ghost text-4xl text-purple-400/40 mb-3"></i>
                            <p class="text-sm text-purple-300/60">No hay contenido disponible en esta galería por el momento.</p>
                        </div>
                    `;
                    return;
                }

                filtered.forEach(item => {
                    const card = document.createElement('div');
                    card.className = "glass-card rounded-2xl overflow-hidden flex flex-col justify-between cursor-pointer group";
                    card.onclick = () => openPlayerModal(item.id);

                    let iconType = cat === 'audiolibros' ? 'fa-headphones' : (cat === 'libros' ? 'fa-book-open' : 'fa-music');

                    card.innerHTML = `
                        <div>
                            <div class="relative h-52 w-full overflow-hidden">
                                <img src="${item.cover}" alt="${item.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" onerror="this.src='https://placehold.co/600x600/1e1234/a855f7?text=Reflexionan2'">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                                <span class="absolute top-3 right-3 px-3 py-1 rounded-full text-[10px] font-bold bg-slate-950/70 border border-purple-500/30 text-purple-200 backdrop-blur-md">
                                    <i class="fa-solid ${iconType} mr-1 text-pink-400"></i> ${cat.toUpperCase()}
                                </span>
                            </div>
                            <div class="p-5">
                                <h4 class="text-lg font-bold text-white font-cinzel line-clamp-1 group-hover:text-pink-300 transition-colors">${item.title}</h4>
                                <p class="text-xs text-purple-300/70 mt-1">${item.author}</p>
                            </div>
                        </div>
                        <div class="px-5 pb-5 flex items-center justify-between text-xs border-t border-purple-900/30 pt-3">
                            <span class="text-pink-400 flex items-center font-semibold">
                                <i class="fa-solid fa-heart mr-1"></i> ${item.likes || 0}
                            </span>
                            <span class="px-3 py-1 rounded-full bg-purple-600/30 text-purple-200 group-hover:bg-pink-600/50 transition-colors">
                                Abrir Obra <i class="fa-solid fa-arrow-right ml-1"></i>
                            </span>
                        </div>
                    `;
                    grid.appendChild(card);
                });
            });
        }

        /* ==========================================================================
           REPRODUCTOR Y LECTOR INMERSIVO (MODAL SUBLIME)
           ========================================================================== */

        function openPlayerModal(itemId) {
            const item = items.find(i => i.id === itemId);
            if (!item) return;

            currentActiveItem = item;

            // Elementos del Modal
            document.getElementById('modal-bg-blur').style.backgroundImage = `url('${item.cover}')`;
            document.getElementById('modal-cover').src = item.cover;
            document.getElementById('modal-title').innerText = item.title;
            document.getElementById('modal-author').innerText = item.author;
            document.getElementById('like-count').innerText = item.likes || 0;

            const badge = document.getElementById('modal-type-badge');
            const audioContainer = document.getElementById('modal-audio-container');
            const textContainer = document.getElementById('modal-text-container');
            const karaokeContainer = document.getElementById('modal-karaoke-container');
            const audioPlayer = document.getElementById('modal-audio-player');

            // Reset visibilidad de secciones
            audioContainer.classList.add('hidden');
            textContainer.classList.add('hidden');
            karaokeContainer.classList.add('hidden');
            audioPlayer.pause();

            if (item.category === 'audiolibros') {
                badge.innerText = "Audiolibro Escuchable";
                audioContainer.classList.remove('hidden');
                audioPlayer.src = item.audio;
            } else if (item.category === 'libros') {
                badge.innerText = "Lectura Protegida";
                textContainer.classList.remove('hidden');
                document.getElementById('modal-book-content').innerText = item.text;
            } else if (item.category === 'canciones') {
                badge.innerText = "Canción Inédita + Karaoke";
                audioContainer.classList.remove('hidden');
                karaokeContainer.classList.remove('hidden');
                audioPlayer.src = item.audio;
                renderKaraokeLyrics(item.lyrics);
            }

            renderModalSocials();

            // Mostrar Modal con animación
            const modal = document.getElementById('player-modal');
            modal.classList.remove('hidden');
        }

        function closePlayerModal() {
            const audioPlayer = document.getElementById('modal-audio-player');
            audioPlayer.pause();
            document.getElementById('player-modal').classList.add('hidden');
        }

        function toggleLike() {
            if (!currentActiveItem) return;
            currentActiveItem.likes = (currentActiveItem.likes || 0) + 1;
            document.getElementById('like-count').innerText = currentActiveItem.likes;
            
            // Guardar Estado
            localStorage.setItem('r2_items', JSON.stringify(items));
            renderGalleries();
            showToast('¡Gracias por apoyar esta obra!', 'fa-heart');
        }

        function renderKaraokeLyrics(lyricsText) {
            const container = document.getElementById('karaoke-lyrics-box');
            container.innerHTML = '';

            if (!lyricsText) {
                container.innerHTML = '<p class="text-xs text-purple-300/40 italic">Letras no disponibles para esta canción.</p>';
                return;
            }

            const lines = lyricsText.split('\n');
            lines.forEach((line, index) => {
                if (line.trim() !== '') {
                    const p = document.createElement('p');
                    p.className = `lyric-line text-sm sm:text-base ${index === 0 ? 'active' : ''}`;
                    p.innerText = line;
                    container.appendChild(p);
                }
            });

            // Sincronización Interactiva Básica al reproducir
            const audioPlayer = document.getElementById('modal-audio-player');
            audioPlayer.ontimeupdate = () => {
                const allLines = container.querySelectorAll('.lyric-line');
                if (allLines.length === 0) return;
                
                const duration = audioPlayer.duration || 1;
                const progress = audioPlayer.currentTime / duration;
                const activeIndex = Math.floor(progress * allLines.length);

                allLines.forEach((l, idx) => {
                    if (idx === activeIndex) {
                        l.classList.add('active');
                        l.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        l.classList.remove('active');
                    }
                });
            };
        }

