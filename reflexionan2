        }

        function renderConfig() {
            // Actualizar Enlaces de Redes Nav
            const phone = settings.whatsapp || "8092341324";
            document.getElementById('nav-link-whatsapp').href = `https://wa.me/${phone}`;
            document.getElementById('nav-link-facebook').href = settings.facebook || "#";
            document.getElementById('nav-link-instagram').href = settings.instagram || "#";
            document.getElementById('nav-link-youtube').href = settings.youtube || "#";
            document.getElementById('nav-link-twitter').href = settings.twitter || "#";
            document.getElementById('nav-link-email').href = `mailto:${settings.email || ''}`;

            // Cargar en Inputs de Configuración Editor
            document.getElementById('cfg-whatsapp').value = settings.whatsapp || '';
            document.getElementById('cfg-bank').value = settings.bankAccount || '';
            document.getElementById('cfg-paypal').value = settings.paypal || '';
            document.getElementById('cfg-email').value = settings.email || '';
            document.getElementById('cfg-facebook').value = settings.facebook || '';
            document.getElementById('cfg-instagram').value = settings.instagram || '';
            document.getElementById('cfg-youtube').value = settings.youtube || '';
            document.getElementById('cfg-twitter').value = settings.twitter || '';
        }

        function renderModalSocials() {
            const container = document.getElementById('modal-social-icons');
            container.innerHTML = `
                <a href="https://wa.me/${settings.whatsapp}" target="_blank" class="hover:text-emerald-400"><i class="fa-brands fa-whatsapp"></i></a>
                <a href="${settings.facebook}" target="_blank" class="hover:text-blue-400"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="${settings.instagram}" target="_blank" class="hover:text-pink-400"><i class="fa-brands fa-instagram"></i></a>
                <a href="${settings.youtube}" target="_blank" class="hover:text-red-400"><i class="fa-brands fa-youtube"></i></a>
            `;
        }

        /* ==========================================================================
           PANEL ADMINISTRATIVO Y EDITOR PRIVADO
           ========================================================================== */

        function openAdminModal() {
            document.getElementById('auth-modal').classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('auth-modal').classList.add('hidden');
        }

        function handleAuth(e) {
            e.preventDefault();
            const pin = document.getElementById('admin-pin').value;
            if (pin === (settings.adminPin || 'admin123')) {
                closeAuthModal();
                document.getElementById('admin-pin').value = '';
                document.getElementById('admin-modal').classList.remove('hidden');
                renderAdminTable();
                toggleFormFields();
                showToast('Acceso de Editor Autorizado', 'fa-user-check');
            } else {
                showToast('PIN incorrecto', 'fa-triangle-exclamation');
            }
        }

        function closeAdminPanel() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function saveGeneralSettings(e) {
            e.preventDefault();
            settings.whatsapp = document.getElementById('cfg-whatsapp').value;
            settings.bankAccount = document.getElementById('cfg-bank').value;
            settings.paypal = document.getElementById('cfg-paypal').value;
            settings.email = document.getElementById('cfg-email').value;
            settings.facebook = document.getElementById('cfg-facebook').value;
            settings.instagram = document.getElementById('cfg-instagram').value;
            settings.youtube = document.getElementById('cfg-youtube').value;
            settings.twitter = document.getElementById('cfg-twitter').value;

            localStorage.setItem('r2_settings', JSON.stringify(settings));
            renderConfig();
            showToast('Ajustes generales guardados', 'fa-floppy-disk');
        }

        function toggleFormFields() {
            const cat = document.getElementById('item-category').value;
            const fieldAudio = document.getElementById('field-audio-url');
            const fieldText = document.getElementById('field-book-text');
            const fieldKaraoke = document.getElementById('field-karaoke-lyrics');

            fieldAudio.classList.remove('hidden');
            fieldText.classList.add('hidden');
            fieldKaraoke.classList.add('hidden');

            if (cat === 'libros') {
                fieldAudio.classList.add('hidden');
                fieldText.classList.remove('hidden');
            } else if (cat === 'canciones') {
                fieldKaraoke.classList.remove('hidden');
            }
        }

        function handleSaveItem(e) {
            e.preventDefault();
            const id = document.getElementById('edit-item-id').value;
            const category = document.getElementById('item-category').value;
            const title = document.getElementById('item-title').value;
            const author = document.getElementById('item-author').value;
            const cover = document.getElementById('item-cover').value;
            const audio = document.getElementById('item-audio').value;
            const text = document.getElementById('item-text').value;
            const lyrics = document.getElementById('item-lyrics').value;

            if (id) {
                // Editar Existente
                const idx = items.findIndex(i => i.id === id);
                if (idx !== -1) {
                    items[idx] = { ...items[idx], category, title, author, cover, audio, text, lyrics };
                }
            } else {
                // Nuevo
                const newItem = {
                    id: 'item_' + Date.now(),
                    category,
                    title,
                    author,
                    cover,
                    audio,
                    text,
                    lyrics,
                    hidden: false,
                    likes: 0
                };
                items.unshift(newItem);
            }

            localStorage.setItem('r2_items', JSON.stringify(items));
            renderGalleries();
            renderAdminTable();
            resetItemForm();
            showToast('Obra guardada exitosamente', 'fa-circle-check');
        }

        function resetItemForm() {
            document.getElementById('edit-item-id').value = '';
            document.getElementById('item-form').reset();
            document.getElementById('form-item-title').innerHTML = '<i class="fa-solid fa-plus-circle mr-2"></i> Publicar Nuevo Contenido';
            toggleFormFields();
        }

        function renderAdminTable() {
            const tbody = document.getElementById('admin-items-table');
            tbody.innerHTML = '';

            items.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-purple-900/20 transition-colors";

                tr.innerHTML = `
                    <td class="p-3">
                        <img src="${item.cover}" class="w-10 h-10 object-cover rounded-lg border border-purple-500/30" onerror="this.src='https://placehold.co/100'">
                    </td>
                    <td class="p-3">
                        <p class="font-bold text-white">${item.title}</p>
                        <p class="text-[10px] text-purple-300/60">${item.author}</p>
                    </td>
                    <td class="p-3 uppercase text-[10px] font-bold text-pink-400">${item.category}</td>
                    <td class="p-3">
                        <span class="px-2 py-0.5 rounded-full text-[10px] ${item.hidden ? 'bg-red-500/20 text-red-300' : 'bg-emerald-500/20 text-emerald-300'}">
                            ${item.hidden ? 'Oculto' : 'Público'}
                        </span>
                    </td>
                    <td class="p-3 text-right space-x-1">
                        <button onclick="toggleHideItem('${item.id}')" class="p-1.5 rounded-lg glass-panel hover:bg-purple-600/40 text-purple-200" title="${item.hidden ? 'Mostrar' : 'Ocultar'}">
                            <i class="fa-solid ${item.hidden ? 'fa-eye' : 'fa-eye-slash'}"></i>
                        </button>
                        <button onclick="editItem('${item.id}')" class="p-1.5 rounded-lg glass-panel hover:bg-cyan-600/40 text-cyan-200" title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button onclick="deleteItem('${item.id}')" class="p-1.5 rounded-lg glass-panel hover:bg-red-600/40 text-red-300" title="Eliminar">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function toggleHideItem(id) {
            const item = items.find(i => i.id === id);
            if (item) {
                item.hidden = !item.hidden;
                localStorage.setItem('r2_items', JSON.stringify(items));
                renderGalleries();
                renderAdminTable();
                showToast(item.hidden ? 'Obra ocultada' : 'Obra visible en público', 'fa-eye');
            }
        }

        function editItem(id) {
            const item = items.find(i => i.id === id);
            if (!item) return;

            document.getElementById('edit-item-id').value = item.id;
            document.getElementById('item-category').value = item.category;
            document.getElementById('item-title').value = item.title;
            document.getElementById('item-author').value = item.author;
            document.getElementById('item-cover').value = item.cover;
            document.getElementById('item-audio').value = item.audio || '';
            document.getElementById('item-text').value = item.text || '';
            document.getElementById('item-lyrics').value = item.lyrics || '';

            document.getElementById('form-item-title').innerHTML = '<i class="fa-solid fa-pen-to-square mr-2"></i> Editando Obra';
            toggleFormFields();
        }

        function deleteItem(id) {
            if (confirm('¿Estás seguro de que deseas eliminar esta obra permanentemente?')) {
                items = items.filter(i => i.id !== id);
                localStorage.setItem('r2_items', JSON.stringify(items));
                renderGalleries();
                renderAdminTable();
                showToast('Obra eliminada del catálogo', 'fa-trash-can');
            }
        }

        /* ==========================================================================
           NOTIFICACIONES DE SISTEMA
           ========================================================================== */

        function showToast(message, iconClass = 'fa-circle-check') {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = message;
            document.getElementById('toast-icon').className = `fa-solid ${iconClass} text-pink-400 text-lg`;

            toast.classList.remove('opacity-0', 'translate-y-20', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-20', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>
</html>
